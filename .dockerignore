# Ignore build and dependency directories
dist
build
sbcli*

# Ignore logs
*.log

# Ignore environment files
.env
.env.*

# Ignore test/tooling caches and virtualenvs (not needed at runtime;
# these can carry outdated, vulnerable copies of pip/setuptools/wheel
# that trip up the Trivy image scan)
.tox
.mypy_cache
.ruff_cache
.pytest_cache

# Ignore Docker-related files
Dockerfile
docker-compose.yml

# Ignore temporary files
*.tmp
*.swp
*.bak

# Ignore OS-specific files
.DS_Store
Thumbs.db

# git folder
.git

# Ignore generated sbcli files
