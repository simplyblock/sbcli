apiVersion: batch/v1
kind: Job
metadata:
  name: {{ CORE_JOBNAME }}
  namespace: {{ NAMESPACE }}
spec:
  template:
    spec:
      restartPolicy: OnFailure
      nodeSelector:
        kubernetes.io/hostname: {{ HOSTNAME }}
      hostNetwork: true
      hostPID: true
      serviceAccountName: simplyblock-storage-node-sa
      tolerations:
        - effect: NoSchedule
          operator: Exists
        - effect: NoExecute
          operator: Exists
      volumes:
        - name: var-simplyblock
          hostPath:
            path: /var/simplyblock
      containers:
        - name: init-setup
          image: alpine/kubectl:1.34.1
          securityContext:
            privileged: true
          volumeMounts:
            - name: var-simplyblock
              mountPath: /var/simplyblock
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -e
              MARKER="/var/simplyblock/.cpu_topology_applied"

              # Resource names — one MCP/MC/KC shared across all storage nodes in the cluster.
              # The MCP nodeSelector grows as new nodes are added (In operator).
              MCP_NAME="storage-{{ CLUSTER_ID }}"
              MC_NAME="storage-mc-{{ CLUSTER_ID }}"
              KC_NAME="storage-kubelet-{{ CLUSTER_ID }}"
              KC_LABEL="storage-cpumanager-{{ CLUSTER_ID }}"
              HOSTNAME="{{ HOSTNAME }}"

              # ---- Order --------------------------------------------------
              # A pool renders from the MachineConfigs that exist when it is
              # evaluated. A host joined to a pool created a moment earlier, before
              # its MachineConfig and KubeletConfig, is sent to a render without
              # the kubelet settings and reboots into it, then reboots again when
              # the complete render arrives, which is usually byte-identical to the
              # one it started on. So the pool is created selecting no host, the
              # MachineConfig and KubeletConfig are added, and the host joins only
              # once the pool's render carries the generated kubelet config: a host
              # whose config already has the same content then moves without a
              # reboot.
              PENDING_HOST="pending-storage-pool"

              # Hostnames a storage pool selects, one per line.
              pool_hosts() {
                kubectl get machineconfigpool "$1" \
                  -o jsonpath='{range .spec.nodeSelector.matchExpressions[?(@.key=="kubernetes.io/hostname")].values[*]}{@}{"\n"}{end}' 2>/dev/null
              }

              # ---- MachineConfigPool ----------------------------------------
              # Created, never applied: `kubectl apply` on a pool that already
              # exists replaces its nodeSelector values with the placeholder below
              # (client-side apply replaces lists on a CRD) and evicts every joined
              # host into a reboot. A pool a sibling node-add created a moment ago
              # is simply reused; any other failure stops the job.
              cat <<MCPEOF > /tmp/mcp.yaml
              apiVersion: machineconfiguration.openshift.io/v1
              kind: MachineConfigPool
              metadata:
                name: $MCP_NAME
                labels:
                  custom-kubelet: $KC_LABEL
              spec:
                machineConfigSelector:
                  matchExpressions:
                    - key: machineconfiguration.openshift.io/role
                      operator: In
                      values:
                        - worker
                        {% if OPENSHIFT_MCP and OPENSHIFT_MCP != 'worker' %}
                        - {{ OPENSHIFT_MCP }}
                        {% endif %}
                        - $MCP_NAME
                nodeSelector:
                  matchExpressions:
                    - key: kubernetes.io/hostname
                      operator: In
                      values:
                        - $PENDING_HOST
                # Wide during initial node-add so first-time CPU-topology
                # reboots roll in parallel (nodes are empty pre-activation);
                # cluster_activate narrows this to the fault tolerance once the
                # cluster serves IO.
                maxUnavailable: {{ MCP_MAX_UNAVAILABLE }}
              MCPEOF
              if CREATE_OUT=$(kubectl create -f /tmp/mcp.yaml 2>&1); then
                echo "[INFO] Created MCP $MCP_NAME, selecting no host until it has rendered"
              else
                case "$CREATE_OUT" in
                  *AlreadyExists*) echo "[INFO] MCP $MCP_NAME already exists" ;;
                  *) echo "[ERROR] Creating MCP $MCP_NAME failed: $CREATE_OUT"; exit 1 ;;
                esac
              fi

              # ---- MachineConfig --------------------------------------------
              # Role matches MCP name so MCO-generated KubeletConfig MC is also picked up.
              if kubectl get machineconfig "$MC_NAME" > /dev/null 2>&1; then
                echo "[INFO] MC $MC_NAME already exists — skipping"
              else
                echo "[INFO] Creating MC $MC_NAME"
                cat <<MCEOF | kubectl apply -f -
              apiVersion: machineconfiguration.openshift.io/v1
              kind: MachineConfig
              metadata:
                name: $MC_NAME
                labels:
                  machineconfiguration.openshift.io/role: $MCP_NAME
              spec:
                config:
                  ignition:
                    version: 3.2.0
              MCEOF
              fi

              # ---- KubeletConfig --------------------------------------------
              if kubectl get kubeletconfig "$KC_NAME" > /dev/null 2>&1; then
                echo "[INFO] KubeletConfig $KC_NAME already exists — skipping"
              else
                echo "[INFO] Creating KubeletConfig $KC_NAME"
                cat <<KCEOF | kubectl apply -f -
              apiVersion: machineconfiguration.openshift.io/v1
              kind: KubeletConfig
              metadata:
                name: $KC_NAME
              spec:
                machineConfigPoolSelector:
                  matchLabels:
                    custom-kubelet: $KC_LABEL
                kubeletConfig:
                  cpuManagerPolicy: static
                  cpuManagerReconcilePeriod: 5s
                  topologyManagerPolicy: single-numa-node
                  reservedSystemCPUs: {{ RESERVED_SYSTEM_CPUS }}
              KCEOF
              fi

              # ---- Wait for the complete render -----------------------------
              # The render controller names the generated kubelet config
              # 99-<pool>-generated-kubelet, with a numeric suffix when another
              # KubeletConfig already selects the pool, so the prefix is matched.
              # The pool's target render is complete once its sources carry it and
              # the MachineConfig. A render that does not complete in time is not
              # waited on forever: a merely slow one still gets the host, at the
              # cost of the reboot this ordering exists to avoid; a render MCO has
              # rejected never completes, and joining would put the host on a
              # render without the kubelet settings, to fail much later at the
              # NUMA readiness check, so that stops the job with the reason.
              KC_GENERATED="99-${MCP_NAME}-generated-kubelet"
              RENDER_WAIT=0
              while [ $RENDER_WAIT -lt 60 ]; do
                SOURCES=$(kubectl get machineconfigpool "$MCP_NAME" \
                  -o jsonpath='{range .spec.configuration.source[*]}{.name}{"\n"}{end}' 2>/dev/null || true)
                if echo "$SOURCES" | grep -q "^${KC_GENERATED}" && echo "$SOURCES" | grep -qx "$MC_NAME"; then
                  echo "[INFO] MCP $MCP_NAME has rendered $MC_NAME and $KC_GENERATED"
                  break
                fi
                RENDER_WAIT=$((RENDER_WAIT + 1))
                echo "[INFO] Waiting for MCP $MCP_NAME to render $MC_NAME and $KC_GENERATED ($RENDER_WAIT/60)..."
                sleep 5
              done
              if [ $RENDER_WAIT -ge 60 ]; then
                echo "[WARN] MCP $MCP_NAME did not render $MC_NAME and $KC_GENERATED in 5 minutes"
                echo "[WARN] KubeletConfig $KC_NAME conditions: $(kubectl get kubeletconfig "$KC_NAME" -o jsonpath='{.status.conditions}' 2>&1 || true)"
                echo "[WARN] MCP $MCP_NAME conditions: $(kubectl get machineconfigpool "$MCP_NAME" -o jsonpath='{.status.conditions}' 2>&1 || true)"
                if kubectl get kubeletconfig "$KC_NAME" -o jsonpath='{.status.conditions[?(@.type=="Failure")].status}' 2>/dev/null | grep -q True \
                   || kubectl get machineconfigpool "$MCP_NAME" -o jsonpath='{.status.conditions[?(@.type=="RenderDegraded")].status}' 2>/dev/null | grep -q True; then
                  echo "[ERROR] MCO rejected the kubelet config of MCP $MCP_NAME; not joining $HOSTNAME to an incomplete render"
                  exit 1
                fi
                echo "[WARN] Joining $HOSTNAME anyway"
              fi

              # ---- Join -----------------------------------------------------
              # The first host takes the placeholder's slot, so a joined pool lists
              # only real hosts; later hosts append. Both patches run server-side,
              # so concurrent joins cannot lose each other: the second host to try
              # the slot fails the test op and appends instead. A transient API
              # error, here as at the pool lookup, is retried rather than left to
              # abort the job and restart the whole flow.
              JOIN_RETRY=0
              while :; do
                if EXISTING=$(pool_hosts "$MCP_NAME"); then
                  if echo "$EXISTING" | grep -qx "$HOSTNAME"; then
                    echo "[INFO] $HOSTNAME already in MCP nodeSelector, skipping patch"
                    break
                  fi
                  if echo "$EXISTING" | grep -qx "$PENDING_HOST" && kubectl patch machineconfigpool "$MCP_NAME" --type=json \
                      -p "[{\"op\": \"test\", \"path\": \"/spec/nodeSelector/matchExpressions/0/values/0\", \"value\": \"$PENDING_HOST\"},
                           {\"op\": \"replace\", \"path\": \"/spec/nodeSelector/matchExpressions/0/values/0\", \"value\": \"$HOSTNAME\"}]"; then
                    echo "[INFO] Added $HOSTNAME to MCP $MCP_NAME in place of $PENDING_HOST"
                    break
                  fi
                  if kubectl patch machineconfigpool "$MCP_NAME" --type=json \
                      -p "[{\"op\": \"add\", \"path\": \"/spec/nodeSelector/matchExpressions/0/values/-\", \"value\": \"$HOSTNAME\"}]"; then
                    echo "[INFO] Added $HOSTNAME to MCP $MCP_NAME"
                    break
                  fi
                fi
                JOIN_RETRY=$((JOIN_RETRY + 1))
                if [ $JOIN_RETRY -ge 15 ]; then
                  echo "[ERROR] Could not join $HOSTNAME to MCP $MCP_NAME"
                  exit 1
                fi
                echo "[WARN] Joining $HOSTNAME to MCP $MCP_NAME failed, retry $JOIN_RETRY/15 in 2s..."
                sleep 2
              done

              # ---- Enforce single storage-pool membership -------------------
              # A node belongs to exactly ONE storage MCP. A previous cluster
              # (different UUID -> different pool name) may still list this node
              # in its storage-<oldid> pool; matching two custom pools makes MCO
              # refuse the node ("belongs to 2 custom roles") and freeze its
              # rollout. We just added the node to our pool ABOVE, so now drop it
              # from every OTHER storage-* pool. Add-before-remove is deliberate:
              # the node is never in zero custom pools, so it never falls back to
              # the worker pool and never eats an extra reboot. We only edit
              # nodeSelectors (never delete the old pool or its render), so the
              # node just moves between identical-content renders — no reboot —
              # and the stale pool harmlessly shrinks toward empty.
              for OTHER in $(kubectl get mcp -o name | sed 's#.*/##' | grep '^storage-' | grep -v "^${MCP_NAME}$"); do
                RETRY=0
                # Retry: sibling node-add jobs may patch the same stale pool
                # concurrently; each job loops until ITS hostname is gone, which
                # converges under last-write-wins for the small parallel-add fan-out.
                while [ $RETRY -lt 15 ]; do
                  if ! pool_hosts "$OTHER" | grep -qx "$HOSTNAME"; then
                    break
                  fi
                  NEWVALS=$(pool_hosts "$OTHER" \
                    | grep -vx "$HOSTNAME" \
                    | awk 'BEGIN{printf "["} {printf "%s\"%s\"", (NR>1?",":""), $0} END{printf "]"}')
                  # An In-operator selector with EMPTY values is invalid
                  # ("values set can't be empty") and makes MCO degrade EVERY
                  # node cluster-wide, freezing any node still migrating off this
                  # pool's render. When removing the pool's last node, retire it
                  # with a sentinel that matches no host instead of emptying it;
                  # the pool becomes inert (0 nodes) but stays a valid object, so
                  # nodes on its identical render migrate to their new pool.
                  if [ "$NEWVALS" = "[]" ]; then
                    NEWVALS='["retired-empty-storage-pool"]'
                  fi
                  echo "[INFO] Removing $HOSTNAME from stale storage pool $OTHER (values -> $NEWVALS)"
                  kubectl patch machineconfigpool "$OTHER" --type=merge \
                    -p "{\"spec\":{\"nodeSelector\":{\"matchExpressions\":[{\"key\":\"kubernetes.io/hostname\",\"operator\":\"In\",\"values\":$NEWVALS}]}}}" || true
                  RETRY=$((RETRY + 1))
                  sleep 2
                done
              done

              # MCP membership + MC + KubeletConfig are ensured on every run above,
              # so a stale marker can never leave this node off the pool config.
              # The marker only records that this node has already been through the
              # first-time flow: if present, skip the reboot wait and just confirm
              # NUMA-plugin readiness. SPDK start is gated separately by the agent
              # (it waits for the MCO reboot to actually land), so correctness no
              # longer depends on this marker being in sync.
              if [ -f "$MARKER" ]; then
                  echo "[INFO] Node already configured. Waiting for NUMA plugin pod to be ready..."
                  RETRIES=0
                  while [ $RETRIES -lt 36 ]; do
                    PLUGIN_READY=$(kubectl get pod -n kube-system \
                      --field-selector spec.nodeName={{ HOSTNAME }} \
                      -l app=simplyblock-numa-resource-plugin \
                      -o jsonpath='{.items[0].status.containerStatuses[0].ready}' 2>/dev/null || true)
                    NUMA_ALLOC=$(kubectl get node "{{ HOSTNAME }}" \
                      -o jsonpath='{.status.allocatable.numa-align/numa-{{ NSOCKET }}}' 2>/dev/null || true)
                    if [ "$PLUGIN_READY" = "true" ] && [ "$NUMA_ALLOC" = "100" ]; then
                      echo "[INFO] NUMA plugin is ready and numa-align/numa-{{ NSOCKET }} is available (100)"
                      exit 0
                    fi
                    RETRIES=$((RETRIES + 1))
                    echo "[INFO] Waiting for NUMA readiness (plugin=$PLUGIN_READY, allocatable=$NUMA_ALLOC), retry $RETRIES/36 in 10s..."
                    sleep 10
                  done
                  echo "[ERROR] NUMA plugin did not become ready after 6 minutes"
                  exit 1
              fi

              echo "[INFO] Marking node as configured."
              touch "$MARKER"

              echo "[INFO] Node is updating the kubeletconfig, waiting for reboot..."
              sleep 900
