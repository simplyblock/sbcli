{% from 'kubelet_restart.j2' import restart_kubelet %}
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ CORE_JOBNAME }}
  namespace: {{ NAMESPACE }}
spec:
  template:
    spec:
      restartPolicy: OnFailure
      nodeSelector:
        kubernetes.io/hostname: {{ HOSTNAME }}

      hostNetwork: true
      hostPID: true

      serviceAccountName: simplyblock-storage-node-sa
      tolerations:
        - effect: NoSchedule
          operator: Exists
        - effect: NoExecute
          operator: Exists

      volumes:
        - name: host
          hostPath:
            path: /
        - name: var-simplyblock
          hostPath:
            path: /var/simplyblock

      containers:
        - name: kubelet-cpu-topology
          image: quay.io/simplyblock-io/alpine:3.20
          securityContext:
            privileged: true
          volumeMounts:
            - name: host
              mountPath: /host
            - name: var-simplyblock
              mountPath: /var/simplyblock
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -euo pipefail

              MARKER="/var/simplyblock/.cpu_topology_applied"
              if [ -f "$MARKER" ]; then
                echo "[INFO] Node already configured. Exiting."
                exit 0
              fi

              # Where the kubelet reads its configuration. A kubelet started with
              # --config names the file on its command line: the EKS images keep it
              # under /etc/kubernetes/kubelet. The kubeadm default stands for a
              # kubelet that names none, and for one embedded in another process.
              KUBELET_CFG_ON_HOST="/var/lib/kubelet/config.yaml"
              CFG_FROM_KUBELET=""
              # Found by its name in /proc rather than with pgrep: the pgrep of this
              # image is the one of BusyBox, whose -x does not match the kubelet.
              KUBELET_PID=""
              for comm in /proc/[0-9]*/comm; do
                if [ "$(cat "$comm" 2>/dev/null)" = "kubelet" ]; then
                  KUBELET_PID="$(basename "$(dirname "$comm")")"
                  break
                fi
              done
              if [ -n "$KUBELET_PID" ] && [ -r "/proc/$KUBELET_PID/cmdline" ]; then
                CFG_FROM_KUBELET="$(tr '\0' '\n' < "/proc/$KUBELET_PID/cmdline" \
                  | awk 'prev == "--config" { print; exit } /^--config=/ { sub(/^--config=/, ""); print; exit } { prev = $0 }' \
                  | tr -d '"')"
              fi
              if [ -n "$CFG_FROM_KUBELET" ]; then
                KUBELET_CFG_ON_HOST="$CFG_FROM_KUBELET"
              fi
              KUBELET_CFG="/host$KUBELET_CFG_ON_HOST"
              BACKUP="${KUBELET_CFG}.pre-simplyblock.bak"
              CPU_MNG="/host/var/lib/kubelet/cpu_manager_state"
              SYSTEMD_UNIT_DIR="/host/etc/systemd/system/kubelet.service.d"
              DROPIN="$SYSTEMD_UNIT_DIR/20-simplyblock-cpu-manager.conf"

              apk add --no-cache sed grep coreutils util-linux jq

              echo "[INFO] Ensuring kubelet config exists at $KUBELET_CFG"
              if [ ! -f "$KUBELET_CFG" ]; then
                echo "[ERROR] kubelet config not found at $KUBELET_CFG"
                echo "        The kubelet names no --config, and the default file is not there."
                exit 1
              fi

              # Backup once
              if [ ! -f "$BACKUP" ]; then
                cp -a "$KUBELET_CFG" "$BACKUP"
              fi

              # The settings (idempotent):
              # cpuManagerPolicy: static
              # cpuManagerReconcilePeriod: 5s
              # topologyManagerPolicy: single-numa-node
              # topologyManagerScope: pod
              # reservedSystemCPUs: "0,1"
              #
              # The file is JSON on the EKS images and YAML on a kubeadm host.
              if [ "$(tr -d '[:space:]' < "$KUBELET_CFG" | cut -c1)" = "{" ]; then
                echo "[INFO] $KUBELET_CFG_ON_HOST is JSON"
                # The kubelet does not start with reservedSystemCPUs beside a
                # reserved cgroup, and the Amazon Linux 2023 image sets both.
                jq --arg reserved "{{ RESERVED_SYSTEM_CPUS }}" '
                  .cpuManagerPolicy = "static"
                  | .cpuManagerReconcilePeriod = "5s"
                  | .topologyManagerPolicy = "single-numa-node"
                  | .topologyManagerScope = "pod"
                  | .reservedSystemCPUs = $reserved
                  | del(.kubeReservedCgroup, .systemReservedCgroup)
                ' "$KUBELET_CFG" > "${KUBELET_CFG}.simplyblock.tmp"
                # Written through the existing file, which keeps its owner and mode.
                cat "${KUBELET_CFG}.simplyblock.tmp" > "$KUBELET_CFG"
                rm -f "${KUBELET_CFG}.simplyblock.tmp"
              else
                set_key () {
                  key="$1"; val="$2"
                  if grep -qE "^${key}:" "$KUBELET_CFG"; then
                    sed -i -E "s|^${key}:.*|${key}: ${val}|" "$KUBELET_CFG"
                  else
                    printf "\n%s: %s\n" "$key" "$val" >> "$KUBELET_CFG"
                  fi
                }

                set_key "cpuManagerPolicy" "static"
                set_key "cpuManagerReconcilePeriod" "5s"
                set_key "topologyManagerPolicy" "single-numa-node"
                set_key "topologyManagerScope" "pod"
                set_key "reservedSystemCPUs" {{ RESERVED_SYSTEM_CPUS }}
              fi

              echo "[INFO] kubelet config updated:"
              grep -E "(cpuManagerPolicy|cpuManagerReconcilePeriod|topologyManagerPolicy|topologyManagerScope|reservedSystemCPUs)" "$KUBELET_CFG" || true

              # A kubelet that names no --config has to be pointed at the file.
              # Many kubeadm setups already do via systemd: ExecStart=... --config=/var/lib/kubelet/config.yaml
              # If not present, add a systemd drop-in to force it.
              if [ -z "$CFG_FROM_KUBELET" ]; then
                mkdir -p "$SYSTEMD_UNIT_DIR"
                if ! grep -R --quiet -- "--config=/var/lib/kubelet/config.yaml" /host/etc/systemd/system /host/lib/systemd/system /host/usr/lib/systemd/system 2>/dev/null; then
                  echo "[WARN] Did not detect kubelet --config flag; adding drop-in $DROPIN"
                  printf '[Service]\nEnvironment="KUBELET_EXTRA_ARGS=--config=/var/lib/kubelet/config.yaml"\n' > "$DROPIN"
                fi
              fi

              # The state the kubelet kept for the old policy, which it refuses
              # to start with under the new one.
              echo "removing old cpu_manager_state..."
              rm -rf $CPU_MNG

              echo "[INFO] Restarting kubelet via host systemd..."
              if ! nsenter --target 1 --mount --uts --ipc --net --pid -- /bin/sh -c '
                {{ restart_kubelet(required=true) | trim | indent(16) }}
              '; then
                # A kubelet that does not run takes the node out of the cluster, so
                # the configuration it ran with is put back before the Job fails.
                echo "[ERROR] The kubelet did not come back with the new configuration. Restoring $KUBELET_CFG_ON_HOST."
                cat "$BACKUP" > "$KUBELET_CFG"
                rm -rf $CPU_MNG
                nsenter --target 1 --mount --uts --ipc --net --pid -- /bin/sh -c '
                  {{ restart_kubelet() | trim | indent(18) }}
                ' || true
                exit 1
              fi

              echo "[INFO] Marking node as configured."
              touch "$MARKER"

              echo "[INFO] Done."
              