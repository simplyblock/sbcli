apiVersion: batch/v1
kind: Job
metadata:
  name: {{ UBUNTU_JOBNAME }}
  namespace: {{ NAMESPACE }}
spec:
  template:
    spec:
      restartPolicy: OnFailure
      nodeSelector:
        kubernetes.io/hostname: {{ HOSTNAME }}
      hostNetwork: true
      hostPID: true
      serviceAccountName: simplyblock-storage-node-sa
      tolerations:
        - effect: NoSchedule
          operator: Exists
        - effect: NoExecute
          operator: Exists
      volumes:
        - name: rootfs
          hostPath:
            path: /
      containers:
        - name: init-setup
          image: ubuntu:22.04
          securityContext:
            privileged: true
          volumeMounts:
            - name: rootfs
              mountPath: /
          command: ["/bin/sh", "-c"]
          # The host's root is mounted over the container's, so this runs the
          # host's /bin/sh (dash on Ubuntu) against the host's packages: the
          # script must be POSIX sh.
          args:
            - |
              set -e

              if [ -f /etc/os-release ]; then
                  . /etc/os-release
                  OS_ID=$ID
              else
                  echo "[ERROR] Unable to detect OS"
                  exit 1
              fi
              echo "[INFO] Detected OS: $OS_ID"

              case "$OS_ID" in
                  ubuntu)
                      # What is needed is the NVMe-oF module, not the package:
                      # some kernels (Ubuntu's AWS kernels) ship nvme-tcp in
                      # linux-modules and have no linux-modules-extra package.
                      pkg="linux-modules-extra-$(uname -r)"
                      if modprobe -n nvme-tcp 2>/dev/null; then
                          echo "[INFO] nvme-tcp is available"
                      else
                          export DEBIAN_FRONTEND=noninteractive
                          apt-get install -y "$pkg" || { apt-get update && apt-get install -y "$pkg"; }
                      fi
                      ;;
                  *)
                      echo "[WARN] OS $OS_ID not supported for automatic NVMe package installation"
                      ;;
              esac

              echo "--- Init setup complete ---"
