# Per-developer repo paths. Real config is local; the .example is committed.
repo-map.config.json

# Generated indexes. Derived from someone else's repo, can be hundreds of KB,
# and go stale on their next commit. Rebuild with scripts/repo_map.py.
repo-maps/*.md
repo-maps/*.tsv

# Which refs the maps are pinned to. Per-developer and per-run: whoever is
# debugging picks the run, and committing one person's pins would silently
# repoint everyone else's maps.
repo-maps/pins.json

# Pinned checkouts parked by repo_map.py --keep. Real git worktrees of
# someone else s repo; never committed.
worktrees/
